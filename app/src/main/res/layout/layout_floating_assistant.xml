<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_floating_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:background="@drawable/bg_floating_card"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header with Drag Indicator and Close Button -->
    <RelativeLayout
        android:id="@+id/layout_floating_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_input_field" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Mimi Assistant"
            android:textColor="@color/neon_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_floating_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close overlay"
            android:src="@drawable/ic_close_floating" />
    </RelativeLayout>

    <!-- Center Glowing Microphone Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="12dp">

        <FrameLayout
            android:id="@+id/layout_mic_button"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Glowing Pulse Ring behind Mic -->
            <View
                android:id="@+id/view_mic_pulse"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_mic_glow"
                android:visibility="invisible" />

            <!-- Core Mic Button -->
            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_circle" />

            <ImageView
                android:id="@+id/img_mic_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Microphone"
                android:src="@drawable/ic_mic_floating" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_floating_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Listening... Speak to Mimi"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_floating_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:padding="8dp"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Text Input Field & Send Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edt_floating_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Or type a command silently..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_floating_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_mic_circle"
            android:contentDescription="Send command"
            android:padding="10dp"
            android:src="@drawable/ic_send_floating" />
    </LinearLayout>

</LinearLayout>
